APP_NAME="Platinum Security Group"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Africa/Dar_es_Salaam

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local default: sqlite. For WAMP/production MySQL, switch DB_CONNECTION=mysql and set credentials.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=psg_shifts
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Auto sign-out after this many minutes without user activity (clicks/typing/navigation).
# Notification polling does not count as activity.
PSG_SESSION_IDLE_MINUTES=30
PSG_SESSION_IDLE_WARNING_MINUTES=2

# Volume seed targets (migrate:fresh --seed)
PSG_SEED_GUARDS=2500
PSG_SEED_CLIENTS=40
PSG_SEED_SITES_PER_REGION=16
PSG_SEED_SUPERVISORS_PER_REGION=4
PSG_SEED_SHIFT_DAYS=5
# Set to true to auto-seed deployments/shifts on db:seed (default false for manual workflow testing).
PSG_SEED_DEPLOYMENTS=false
PSG_SEED_SHIFTS=false
PSG_SEED_LEAVES=200
PSG_SEED_ABSENCES=300
PSG_SEED_DESERTIONS=40
# Production HTTPS:
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Production: run a worker process, e.g. php artisan queue:work --tries=3 --timeout=120

CACHE_STORE=database
# CACHE_PREFIX=psg_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local/dev: writes to storage/logs/laravel.log
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="ops@platinumsecurity.local"
MAIL_FROM_NAME="${PSG_COMPANY_NAME}"

# Production SMTP example (uncomment and set credentials):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.your-provider.com
# MAIL_PORT=587
# MAIL_USERNAME=ops@your-domain.com
# MAIL_PASSWORD=your-smtp-password
# MAIL_SCHEME=tls
# MAIL_FROM_ADDRESS=ops@your-domain.com
# MAIL_FROM_NAME="${PSG_COMPANY_NAME}"
#
# Verify delivery after configuring:
# php artisan psg:test-mail you@example.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PSG_COMPANY_NAME="Platinum Security Group"
PSG_LOGO=images/logo.jpeg
PSG_TAGLINE="New Age Security and Protection"
PSG_CURRENCY=UGX
PSG_CURRENCY_LABEL="Ugandan Shillings"
PSG_CURRENCY_DECIMALS=0
PSG_BACKUP_KEEP=14
PSG_BACKUP_PATH=backups
PSG_BACKUP_DISK=backups
PSG_BACKUP_SCHEDULE=daily
PSG_BACKUP_NOTIFY=true
PSG_BACKUP_OFFSITE_DISK=
PSG_BACKUP_OFFSITE_PATH=psg-backups
PSG_NOTIFICATIONS_POLL_SECONDS=30
